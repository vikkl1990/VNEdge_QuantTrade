# =============================================================================
# Crypto Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Bot Mode: signal_only | paper | live | backtest | forward_test
BOT_MODE=paper

# Exchange API Keys
DELTA_API_KEY=
DELTA_API_SECRET=

# Active Exchange (Delta Exchange India only)
ACTIVE_EXCHANGE=delta

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change-this-to-a-random-string

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Database (SQLite by default)
DATABASE_URL=sqlite:///data/trading_bot.db

# Security
ENCRYPT_SECRETS=false

# ML Lab server (ml_training/run_trainer.py). Local default:
ML_SERVER_URL=http://127.0.0.1:8091
