# =============================================================================
# Crypto Trading Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Bot Mode: signal_only | paper | live | backtest | forward_test
BOT_MODE=paper

# Exchange API Keys
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
DELTA_API_KEY=
DELTA_API_SECRET=

# Active Exchange: binance | bybit | okx | delta
ACTIVE_EXCHANGE=binance

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change-this-to-a-random-string

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Database (SQLite by default)
DATABASE_URL=sqlite:///data/trading_bot.db

# Security
ENCRYPT_SECRETS=false
